<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ControllerAutoAdjust</AssemblyName>
    <RootNamespace>ControllerAutoAdjust</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The checked-in file carries a placeholder, not a version: one build per supported
         game goes out, and a manifest naming the wrong one makes BSIPA warn on every launch
         that the mod was built for something else. The version comes from the same property
         that chose the reference set, so the two cannot disagree. -->
    <!-- The resource name matters, not just its presence: BSIPA looks for
         <AssemblyName>.manifest.json, which is what including a manifest.json from the
         project root produces by default. Generating it elsewhere changes that name, and a
         mod whose manifest BSIPA cannot find is skipped, it says so, in one NOTICE line
         above the plugin list it is then absent from. -->
    <EmbeddedResource Include="$(IntermediateOutputPath)manifest.json"
                      LogicalName="$(AssemblyName).manifest.json" />
    <EmbeddedResource Include="Views\settings.bsml" />
  </ItemGroup>

  <!--
    Private=false on every one of these. A game assembly copied next to the plugin is loaded
    instead of the real one, and the failure surfaces as a type-identity error that looks
    like anything but a stray DLL.
  -->
  <ItemGroup>
    <Reference Include="IPA.Loader">
      <HintPath>$(BSIPARefDir)IPA.Loader.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BSIPARefDir)0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BSRefDir)UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(BSRefDir)UnityEngine.XRModule.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- VRController and VRControllerTransformOffset live here. -->
    <Reference Include="HMLib">
      <HintPath>$(BSRefDir)HMLib.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Main">
      <HintPath>$(BSRefDir)Main.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- NoteCutInfo is in GameplayCore, NoteData in BeatmapCore; neither is in Main. -->
    <Reference Include="GameplayCore">
      <HintPath>$(BSRefDir)GameplayCore.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="BeatmapCore">
      <HintPath>$(BSRefDir)BeatmapCore.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- ControllerProfilesModel, and the provider that reads it. -->
    <Reference Include="BeatSaber.GameSettings">
      <HintPath>$(BSRefDir)BeatSaber.GameSettings.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- The settings struct and the storage they are written through: saving which profile
         is selected needs both, and nothing else does it for a change made from a mod. -->
    <Reference Include="BeatSaber.Settings">
      <HintPath>$(BSRefDir)BeatSaber.Settings.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="BGLib.FileStorage">
      <HintPath>$(BSRefDir)BGLib.FileStorage.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="DataModels">
      <HintPath>$(BSRefDir)DataModels.dll</HintPath><Private>false</Private>
    </Reference>
    <!-- BSML ships as a mod rather than with the game, so it is resolved from the modded
         install. Assembly name and file name differ; the HintPath is what resolves. -->
    <!-- TextSlider, whose Refresh() is what actually redraws a slider's label. -->
    <Reference Include="HMUI">
      <HintPath>$(BSRefDir)HMUI.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BSRefDir)UnityEngine.UI.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="BeatSaberMarkupLanguage">
      <HintPath>$(BSModdedInstallDir)Plugins\BSML.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Before compile, because the resource has to exist by the time it is embedded. Not
       incremental on purpose: WriteLinesToFile skips an identical file, and a changed
       version has to reach the DLL or the build silently ships the previous one. -->
  <Target Name="StampManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <StampedManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\manifest.json').Replace('__GAMEVERSION__', '$(BSGameVersion)'))</StampedManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)manifest.json" Lines="$(StampedManifest)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
