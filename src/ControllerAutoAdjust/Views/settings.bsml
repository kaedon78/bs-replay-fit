<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
                    xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>

  <!-- Wrapped with an explicit height. A bare text reports no preferred height, so the
       container hands it everything left over and the controls end up below the fold. -->
  <horizontal pref-height='9' pref-width='90'>
    <text text='~status' align='Center' font-size='3.2'/>
  </horizontal>

  <!-- Hidden unless something is running; the fill is driven from code, since BSML has no
       progress-bar tag and will not bind a numeric attribute. -->
  <horizontal id='progress-row' pref-height='4' pref-width='80' bg='panel-top'>
    <image id='progress-fill' src='#RoundRect10' pref-height='3' pref-width='78'
           image-color='#4af'/>
  </horizontal>

  <horizontal pref-height='8' pref-width='90'>
    <action-button id='read-button' text='~read-button' on-click='read'
            hover-hint='Reads your replay files. Slow, and only needed once per session.'/>
  </horizontal>

  <horizontal pref-height='8' pref-width='90'>
    <text text='~scope' align='Center' font-size='2.9'/>
  </horizontal>

  <!-- apply-on-change, on all three, because these are not preferences: the Assign button
       below reads them. BSML writes a setting back to its host on the screen's OK event
       unless told otherwise, so without this the button read the range and profile from
       before the player set them -- and with nothing ever written, it looked inert. -->
  <slider-setting id='from-slider' text='2. Earlier replays: from' value='start-percent'
                  min='0' max='100' increment='2' integer-only='true'
                  formatter='format-session' apply-on-change='true'
                  hover-hint='Applies only to runs from before this mod was installed. Runs it has a record for are unaffected.'/>

  <slider-setting id='until-slider' text='2. Earlier replays: until' value='end-percent'
                  min='0' max='100' increment='2' integer-only='true'
                  formatter='format-session' apply-on-change='true'
                  hover-hint='Applies only to runs from before this mod was installed.'/>

  <list-setting id='profile-list' text='2. Earlier replays were played on' value='profile' choices='profile-choices' apply-on-change='true'
                hover-hint='Which controller profile was in use for that range. Replays do not record it.'/>

  <horizontal pref-height='7' pref-width='90' spacing='2'>
    <button text='Assign that range' on-click='assign'
            hover-hint='Records the range and profile above as one segment, so several grips can be described.'/>
    <button text='Clear' on-click='clear-assignments'
            hover-hint='Forget every assigned range.'/>
  </horizontal>

  <horizontal pref-height='12' pref-width='90'>
    <text text='~assignments' align='Center' font-size='2.9'/>
  </horizontal>

  <horizontal pref-height='8' pref-width='90'>
    <action-button id='fit-button' text='~fit-button' on-click='fit'
            hover-hint='Fits both hands to the range above. Fast, so change the range and refit freely.'/>
  </horizontal>

  <horizontal pref-height='9' pref-width='90'>
    <text text='~advisory' align='Center' font-size='3.2'/>
  </horizontal>

</settings-container>
